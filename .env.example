# ─────────────────────────────────────────────────────────────
# 데이터 소스 스위치
#   seed : lib/seed/*.js 의 로컬 데이터를 사용 (기본값, DB 불필요)
#   db   : MariaDB/MySQL 에 접속해서 조회 (아래 DB_* 값 필요)
# ─────────────────────────────────────────────────────────────
DATA_SOURCE=seed

# Database Info (DATA_SOURCE=db 일 때만 사용)
DB_ADDRESS=127.0.0.1
DB_PORT=3306
DB_ID=portfolio
DB_PASSWORD=
DB_NAME=portfolio

# 사이트 절대 경로 (메타데이터/OG 용)
NEXT_PUBLIC_SITE_URL=http://localhost:3333
